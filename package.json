{
  "name": "fraudnet-ai",
  "version": "0.1.0",
  "private": true,
  "description": "FraudNet AI — Detect. Investigate. Explain.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/run-python.mjs -m uvicorn app.main:app --reload --app-dir backend --port 8000 --reload-include '*.py' --reload-exclude '*.pyc' --reload-exclude '__pycache__' --reload-exclude '.venv'",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "test": "npm run test:backend",
    "test:backend": "cd backend && node ../scripts/run-python.mjs -m pytest -q",
    "lint:backend": "cd backend && node ../scripts/run-python.mjs -m ruff check app tests scripts",
    "format:backend": "cd backend && node ../scripts/run-python.mjs -m ruff format app tests scripts",
    "generate:demo": "cd backend && node ../scripts/run-python.mjs -m scripts.generate_demo_data",
    "seed:demo": "cd backend && node ../scripts/run-python.mjs -m scripts.seed_demo_data"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
