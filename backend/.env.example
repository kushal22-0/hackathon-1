# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# "memory" works immediately for local development and tests.
# "postgres" requires DATABASE_URL and applies the Supabase schema via psql.
REPOSITORY_BACKEND=memory
DATABASE_URL=
# Supabase example (use the session pooler for the API):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Ingestion limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_INGEST_ROWS=50000

# -----------------------------------------------------------------------------
# Detection engine (nested settings use the double-underscore delimiter)
# -----------------------------------------------------------------------------
DETECTION__LARGE_TRANSFER_THRESHOLD=10000
DETECTION__HIGH_FREQUENCY_COUNT=5
DETECTION__HIGH_FREQUENCY_WINDOW_MINUTES=10
DETECTION__RAPID_SUCCESSION_COUNT=3
DETECTION__RAPID_SUCCESSION_SECONDS=60
DETECTION__RULE_WEIGHT=0.60
DETECTION__ML_WEIGHT=0.40
DETECTION__ALERT_THRESHOLD=65
DETECTION__ML_CONTAMINATION=0.05
DETECTION__ML_ESTIMATORS=200
DETECTION__ML_MIN_TRAINING_ROWS=50
DETECTION__ML_MAX_TRAINING_ROWS=10000
DETECTION__MAX_BATCH_SIZE=500
