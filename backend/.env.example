# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# "memory" works immediately for local development and tests.
# "postgres" requires DATABASE_URL and applies the Supabase schema via psql.
REPOSITORY_BACKEND=memory
DATABASE_URL=
# Supabase example (use the session pooler for the API):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Ingestion limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_INGEST_ROWS=50000
