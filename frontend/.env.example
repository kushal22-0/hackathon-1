# Backend origin (no trailing slash). In production, point this at Render.
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth (safe to expose the anon key; never put the service-role key here).
# Used by the later auth-aware UI; the Phase 1 shell works without these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
